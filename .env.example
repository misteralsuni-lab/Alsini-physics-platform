# Alsini Physics Platform - environment template
# Copy the relevant values into your deployment provider's secret store.
# Never commit real keys or tokens.

# ---------------------------------------------------------------------------
# Frontend (Vite) - safe for the browser; set in Vercel (Production + Preview)
# ---------------------------------------------------------------------------

# Supabase project URL, e.g. https://<project-ref>.supabase.co
VITE_SUPABASE_URL=

# Supabase anon/public key. Public by design; access is governed by RLS.
VITE_SUPABASE_ANON_KEY=

# Base URL of the deployed FastAPI backend (HTTPS origin, no trailing slash),
# e.g. https://alsini-api.onrender.com
VITE_API_URL=

# ---------------------------------------------------------------------------
# Backend (FastAPI) - server-only secrets; set in Render, never in Vercel
# ---------------------------------------------------------------------------

# Supabase project URL, e.g. https://<project-ref>.supabase.co
SUPABASE_URL=

# Supabase service-role key. Bypasses RLS; server-only, rotate if leaked.
SUPABASE_SERVICE_ROLE_KEY=

# Supabase anon/public key used to validate incoming user access tokens.
SUPABASE_ANON_KEY=

# NVIDIA API key for RAG query embeddings and the NVIDIA LLM fallback.
NVIDIA_API_KEY=

# OpenCode Zen API key for the primary LLM route.
OPENCODE_ZEN_API_KEY=

# Google Gemini API key for the last-resort LLM route (optional but recommended).
GEMINI_API_KEY=

# Exact production frontend origin allowed by CORS, e.g. https://eduvle.com
FRONTEND_URL=

# Optional comma-separated CORS allowlist. Overrides FRONTEND_URL when set.
# Example: https://eduvle.com,https://www.eduvle.com
CORS_ORIGINS=
